# Copy to .env for local development (never commit the real .env).
# On Render these are set in the dashboard / via render.yaml instead.

# PostgreSQL connection string — Supabase: project > Connect > "Session pooler" URI.
# (The "Direct connection" host is IPv6-only and won't work from Render.)
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase requires SSL, so keep this "on". Use "off" only for a local Postgres without SSL.
DATABASE_SSL=on

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin dashboard passcode (server-side now — real-ish gate, not just client JS).
ADMIN_PASSCODE=055290

# Anthropic (Claude) key for screenshot scanning (vision). Server-side only — never
# sent to the browser. Leave blank to disable the scanner. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-haiku-4-5 — cheapest/fastest for scanning).
CLAUDE_MODEL=claude-haiku-4-5

# Email (Resend) for the "SportyBet account connected" confirmation. Leave blank to
# skip emails (the flow still works). Get a key + verified sender at resend.com.
RESEND_API_KEY=
MAIL_FROM=SportyHacks <noreply@yourdomain.com>

# Port (Render sets this automatically; 3000 for local).
PORT=3000
